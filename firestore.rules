rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check admin role
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }
    
    // User profile documents: Read self or admin, write only with valid non-negative balances
    match /users/{userId} {
      allow read: if true;
      allow create, update: if request.resource.data.tradingBalance >= 0;
      allow delete: if isAdmin();
      
      // Transactions sub-collection: Immutable once created
      match /transactions/{txId} {
        allow read: if true;
        allow create: if request.resource.data.grossAmount > 0;
        allow update, delete: if isAdmin();
      }
    }
    
    // System configuration: Read public, write admin only
    match /system_config/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Audit logs & Security alerts: Append-only
    match /security_alerts/{alertId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if false;
    }
  }
}
