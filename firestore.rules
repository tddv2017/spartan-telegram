rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if true;
      allow write: if false;

      match /transactions/{txId} {
        allow read: if true;
        allow write: if false;
      }
    }

    match /transactions/{txId} {
      allow read: if true;
      allow write: if false;
    }

    match /system_config/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /security_alerts/{alertId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
